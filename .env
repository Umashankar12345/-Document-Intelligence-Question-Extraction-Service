DATABASE_URL=sqlite:///./pragati.db
# For Docker: postgresql+psycopg2://postgres:postgres@db:5432/pragati
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production-please
JWT_ALG=HS256
JWT_EXPIRE_MIN=60
MAX_UPLOAD_MB=25

OCR_PROVIDER=tesseract
EXTRACTOR=heuristic
STORAGE_BACKEND=local
STORAGE_ROOT=./data

CONFIDENCE_OK=0.75
CONFIDENCE_PARTIAL=0.45

# Optional providers
OPENAI_API_KEY=
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

CELERY_TASK_ALWAYS_EAGER=0
ENV=dev
